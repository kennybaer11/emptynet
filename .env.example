# Postgres connection. The tables live in the `emptynet` schema, so this can be
# the same Neon database the posession project uses - nothing collides.
#   postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Where raw API responses and scraped pages are kept so a re-run costs nothing.
# Defaults to ./cache next to this file.
EMPTYNET_CACHE=
